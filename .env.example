# ---------- API (apps/api) ----------
NODE_ENV=development
API_PORT=4000
# Never expose this to the browser
MONGODB_URI=mongodb://localhost:27017/techexpert_energy
REDIS_URL=redis://localhost:6379
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000
# Object storage (Cloudinary or any S3-compatible)
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_BUCKET=techexpert-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TechExpert Energy <no-reply@techexpertenergy.com>"
SALES_NOTIFY_EMAIL=sales@techexpertenergy.com
# Seed admin (used only by `npm run seed`)
SEED_ADMIN_EMAIL=admin@techexpertenergy.com
SEED_ADMIN_PASSWORD=ChangeMe!2026

# ---------- WEB (apps/web) ----------
# Public values only — anything NEXT_PUBLIC_* ships to the browser
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WHATSAPP_NUMBER=8801XXXXXXXXX
